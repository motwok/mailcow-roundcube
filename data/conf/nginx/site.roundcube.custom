
location = /auth_roundcube {
	internal;
	proxy_pass http://127.0.0.1:65510/rc-auth.php;
	proxy_pass_request_body off;
	proxy_set_header Content-Length "";
	proxy_set_header X-Original-URI $request_uri;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /SOGo/dav/ {
	fastcgi_pass phpfpm:9000;
	include fastcgi_params;
	fastcgi_param SCRIPT_FILENAME /web/SoGoMiddleware.php;
	fastcgi_param HTTP_HOST $host;
	fastcgi_param HTTP_X_REAL_IP $remote_addr;
	fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
	fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;

	fastcgi_pass_header Authorization;
	fastcgi_pass_header IF;
	fastcgi_pass_header IF_MATCH;
	fastcgi_pass_header STATUS;

	fastcgi_read_timeout 300s;
	fastcgi_send_timeout 300s;
	fastcgi_buffering off;
}

location /roundcube/ {
	auth_request /auth_roundcube;

	auth_request_set $auth_user $upstream_http_x_user;
	auth_request_set $auth_auth $upstream_http_x_auth;
	auth_request_set $auth_type $upstream_http_x_auth_type;
	auth_request_set $auth_display_name $upstream_http_x_display_name;

	proxy_set_header X-User $auth_user;
	proxy_set_header X-Auth $auth_auth;
	proxy_set_header X-Auth-Type $auth_type;
	proxy_set_header X-Display-Name $auth_display_name;

	proxy_pass http://roundcube:80/;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
}


